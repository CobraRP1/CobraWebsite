---
/**
 * Auto-advancing slideshow of Research Insights, with prev/next arrows beside the
 * box and clickable dots below it. Each slide is a full ResearchInsight (author
 * photo, write-up, and the paper link + PDF), so links and PDF change with the slide.
 */
import type { Paper } from '../lib/types';
import ResearchInsight from './ResearchInsight.astro';

interface Props {
  papers: Paper[];
}

const { papers } = Astro.props;
const multiple = papers.length > 1;
---

<div class="carousel-outer">
  <div class="carousel-wrap">
    {
      multiple && (
        <button type="button" class="arrow arrow-prev" aria-label="Previous insight">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M15 18l-6-6 6-6" />
          </svg>
        </button>
      )
    }

    <div
      class="insights-carousel"
      role="region"
      aria-roledescription="carousel"
      aria-label="Research insights"
    >
      <div class="slides">
        {
          papers.map((paper, i) => (
            <div
              class:list={['slide', { 'is-active': i === 0 }]}
              role="group"
              aria-roledescription="slide"
              aria-label={`${i + 1} of ${papers.length}`}
              aria-hidden={i !== 0 ? 'true' : undefined}
            >
              <ResearchInsight paper={paper} />
            </div>
          ))
        }
      </div>
    </div>

    {
      multiple && (
        <button type="button" class="arrow arrow-next" aria-label="Next insight">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M9 18l6-6-6-6" />
          </svg>
        </button>
      )
    }
  </div>

  {
    multiple && (
      <div class="dots">
        {papers.map((_, i) => (
          <button
            type="button"
            class:list={['dot', { 'is-active': i === 0 }]}
            data-goto={i}
            aria-label={`Show insight ${i + 1}`}
            aria-current={i === 0 ? 'true' : undefined}
          />
        ))}
      </div>
    )
  }
</div>

<script>
  document.querySelectorAll('.insights-carousel').forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll('.slide'));
    if (slides.length < 2) return;

    const outer = carousel.closest('.carousel-outer') ?? carousel;
    const dots = Array.from(outer.querySelectorAll('.dot'));
    const prevBtn = outer.querySelector('.arrow-prev');
    const nextBtn = outer.querySelector('.arrow-next');

    const INTERVAL = 7000;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timer: number | null = null;

    const show = (index: number) => {
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, k) => {
        const active = k === current;
        slide.classList.toggle('is-active', active);
        if (active) slide.removeAttribute('aria-hidden');
        else slide.setAttribute('aria-hidden', 'true');
      });
      dots.forEach((dot, k) => {
        const active = k === current;
        dot.classList.toggle('is-active', active);
        if (active) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
    };

    const stop = () => {
      if (timer !== null) {
        clearInterval(timer);
        timer = null;
      }
    };
    const start = () => {
      if (!reduce && timer === null) {
        timer = window.setInterval(() => show(current + 1), INTERVAL);
      }
    };
    const goto = (index: number) => {
      show(index);
      stop();
      start();
    };

    dots.forEach((dot, k) => dot.addEventListener('click', () => goto(k)));
    prevBtn?.addEventListener('click', () => goto(current - 1));
    nextBtn?.addEventListener('click', () => goto(current + 1));

    // Pause while the visitor is reading (hover / keyboard focus) or the tab is hidden.
    outer.addEventListener('mouseenter', stop);
    outer.addEventListener('mouseleave', start);
    outer.addEventListener('focusin', stop);
    outer.addEventListener('focusout', start);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

    start();
  });
</script>

<style>
  .carousel-outer {
    max-width: 64rem;
    margin-inline: auto;
  }

  .carousel-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
  }

  .insights-carousel {
    flex: 1 1 auto;
    min-width: 0;
    max-width: 56rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-8) var(--space-6);
  }

  /* Small, transparent rectangular prev/next boxes, vertically centred beside
     the slideshow. */
  .arrow {
    flex: 0 0 auto;
    width: 2rem;
    height: 3.25rem;
    display: grid;
    place-items: center;
    padding: 0;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-text-muted);
    cursor: pointer;
    transition:
      background 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .arrow:hover {
    color: var(--color-text);
    border-color: var(--color-border-strong);
    background: rgba(0, 0, 0, 0.02);
  }

  /* All slides share one grid cell, so the carousel keeps the height of the
     tallest slide — advancing crossfades without any layout jump. */
  .slides {
    display: grid;
  }

  .slide {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .slide.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* Dots sit below the box now, centred. */
  .dots {
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-6);
  }

  .dot {
    width: 11px;
    height: 11px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: var(--color-border-strong);
    cursor: pointer;
    transition:
      background 0.15s ease,
      transform 0.15s ease;
  }

  .dot:hover {
    background: var(--color-text-muted);
  }

  .dot.is-active {
    background: var(--color-accent);
    transform: scale(1.25);
  }

  @media (max-width: 640px) {
    .carousel-wrap {
      gap: var(--space-1);
    }

    .arrow {
      width: 1.6rem;
      height: 2.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .slide {
      transition: none;
    }
  }
</style>
