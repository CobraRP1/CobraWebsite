---
import Base from '../layouts/Base.astro';
import PaperEntry from '../components/PaperEntry.astro';
import InsightsCarousel from '../components/InsightsCarousel.astro';
import Placeholder from '../components/Placeholder.astro';
import { publications, workingPapers, research, site } from '../lib/content';

const insightPapers = [...publications, ...workingPapers].filter((p) => p.insight);
const { support, predoc, seminars, publicationsBlurb } = research;
---

<Base title="Research" description={`${site.shortName} research on how regulation, disclosure, taxation, and economic policy shape firm behavior.`}>
  <div class="page-header">
    <div class="container">
      <h1>{research.title}</h1>
      {/* No prose cap -> intro spans the same width as the headline. Both intro
          paragraphs sit directly under the headline, separated by a blank line. */}
      <p class="lede">{research.intro[0]}</p>
      {/* Same font/size as the first paragraph (.lede); MBS CD dark blue instead of muted. */}
      {research.intro.slice(1).map((paragraph) => <p class="lede intro-dark">{paragraph}</p>)}
    </div>
  </div>

  <section class="section" id="research-insights">
    <div class="container">
      <h2 class="subsection-title">Research Insights</h2>
      {research.insightsBlurb && <p class="blurb">{research.insightsBlurb}</p>}
      {
        insightPapers.length > 0 ? (
          <InsightsCarousel papers={insightPapers} />
        ) : (
          <Placeholder note="No research insights yet. Add papers with an `insight` block to src/data/publications.yaml or working-papers.yaml." />
        )
      }
    </div>
  </section>

  <section class="section" id="research-support">
    <div class="container">
      <h2 class="subsection-title">{support.title}</h2>
      {support.intro && <p class="blurb">{support.intro}</p>}
      <div class="support-grid">
        {
          support.items.map((item) => (
            <div class="support-item">
              <h3>{item.title}</h3>
              <p class="muted">{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="predoctoral">
    <div class="container">
      <h2 class="subsection-title">{predoc.title}</h2>
      {predoc.intro && <p class="blurb">{predoc.intro}</p>}

      <div class="programs">
        <article class="program-card">
          <h3>{predoc.programTitle}</h3>
          <p class="program-body">{predoc.programBody}</p>

          <div class="field">
            <p class="field-label">{predoc.opportunitiesLabel}</p>
            <ul class="bullets">
              {predoc.opportunities.map((o) => <li>{o}</li>)}
            </ul>
          </div>

          {
            predoc.placements.length > 0 && (
              <div class="field">
                {predoc.placementsIntro && <p class="field-intro">{predoc.placementsIntro}</p>}
                <ul class="chips">
                  {predoc.placements.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
              </div>
            )
          }
        </article>

        <article class="program-card">
          <h3>{predoc.internshipsTitle}</h3>
          {predoc.internshipsBody.map((p) => <p class="program-body">{p}</p>)}

          <div class="field">
            <p class="field-label">{predoc.opportunitiesLabel}</p>
            <ul class="bullets">
              {predoc.internshipOpportunities.map((o) => <li>{o}</li>)}
            </ul>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="seminars">
    <div class="container">
      <h2 class="subsection-title">{seminars.title}</h2>
      {seminars.paragraphs.map((p) => <p class="para">{p}</p>)}
    </div>
  </section>

  <section class="section" id="publications">
    <div class="container">
      <h2 class="subsection-title">{publicationsBlurb.title}</h2>
      <div>
        {publicationsBlurb.paragraphs.map((p) => <p class="para">{p}</p>)}
      </div>

      {
        workingPapers.length > 0 && (
          <div class="papers">
            <h3 class="papers-title">Working papers</h3>
            {workingPapers.map((paper) => (
              <PaperEntry paper={paper} />
            ))}
          </div>
        )
      }
    </div>
  </section>
</Base>

<style>
  .intro-dark {
    color: var(--color-primary-dark);
  }

  /* Prominent subsection headings (replaces the small uppercase label style). */
  .subsection-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: var(--leading-tight);
    color: var(--color-text);
    margin-bottom: var(--space-6);
  }

  .blurb {
    margin-bottom: var(--space-8);
  }

  .support-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-6);
  }

  .support-item {
    flex: 0 1 18rem;
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .support-item p {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
  }

  .para {
    margin-top: var(--space-4);
  }

  /* Pre-Doctoral Program & Internships — two cards matching the insight/support
     card language, each with clearly separated fields. */
  .programs {
    max-width: 56rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .program-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-8);
  }

  .program-card h3 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
  }

  .program-body {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
  }

  .field {
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .field-label {
    margin-bottom: var(--space-3);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .field-intro {
    margin-bottom: var(--space-4);
    font-size: var(--text-sm);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .chips li {
    font-size: var(--text-sm);
    padding: var(--space-2) var(--space-3);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 999px;
  }

  .bullets {
    margin-top: var(--space-3);
    padding-left: 1.2em;
    list-style: disc;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  .papers {
    margin-top: var(--space-12);
  }

  .papers-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }
</style>
