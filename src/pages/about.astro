---
import Base from '../layouts/Base.astro';
import { about } from '../lib/content';
---

<Base title="About" description={about.hero.intro}>
  <div class="page-header">
    <div class="container">
      <h1>{about.hero.title}</h1>
      <p class="lede">{about.hero.intro}</p>
    </div>
  </div>

  {
    about.sections.map((section) => (
      <section class="section" id={section.id}>
        <div class="container">
          <h2 class="subsection-title">{section.title}</h2>

          {section.paragraphs.map((paragraph) => (
            <p class="para">{paragraph}</p>
          ))}

          {section.listLabel && <p class="list-label">{section.listLabel}</p>}

          {section.bullets && section.bullets.length > 0 && (
            <ul class="bullets">
              {section.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          )}

          {section.cards && section.cards.length > 0 && (
            <div class="card-grid">
              {section.cards.map((card) => (
                <div class="info-card">
                  <h3>{card.term}</h3>
                  <p>{card.description}</p>
                </div>
              ))}
            </div>
          )}
        </div>
      </section>
    ))
  }
</Base>

<style>
  /* Prominent subsection headings — same as the Research page. */
  .subsection-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: var(--leading-tight);
    color: var(--color-text);
    margin-bottom: var(--space-6);
  }

  .para {
    margin-top: var(--space-4);
  }

  .list-label {
    margin-top: var(--space-6);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .bullets {
    margin-top: var(--space-3);
    padding-left: 1.2em;
    list-style: disc;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  /* Term + description items as centred white cards (like Research Support). */
  .card-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .info-card {
    flex: 0 1 20rem;
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .info-card h3 {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .info-card p {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
